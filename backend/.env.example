# Example: mysql+pymysql://cis_user:change_me@localhost:3306/cis_auditor
DATABASE_URL=mysql+pymysql://root:YOUR_MYSQL_PASSWORD@localhost:3306/cis_auditor
APP_NAME=CIS Compliance Auditor API
API_PREFIX=/api

# Comma-separated allowed origins for CORS (Shristi's React frontend)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Set to true for development logging
DEBUG=false
